<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#060b12" />
    <meta name="description" content="A playlist colaborativa do recreio: cinco músicas escolhidas pela turma." />
    <title>@ViewData["Title"] · Recreio Musical</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="rm-body">
    <header class="rm-header">
        <a class="rm-brand" asp-controller="Home" asp-action="Index" aria-label="Colégio Objetivo — Recreio Musical, página inicial">
            <span class="rm-school-plaque">
                <img class="rm-school-logo"
                     src="~/images/logo-objetivo.png"
                     alt=""
                     width="2433"
                     height="296"
                     asp-append-version="true"
                     decoding="async" />
            </span>
            <span class="rm-brand-divider" aria-hidden="true"></span>
            <span class="rm-brand-text"><strong>Recreio</strong> Musical</span>
        </a>

        <div class="rm-header-meta">
            <span class="rm-pill rm-pill--accent">Playlist colaborativa</span>
            <span class="rm-pill">5 vagas</span>
        </div>
    </header>

    <main class="rm-main" role="main">
        @RenderBody()
    </main>

    <footer class="rm-footer">
        <span>Feito para o intervalo. Escolha com carinho.</span>
        <span>Dados de músicas via Spotify · ASP.NET Core 10</span>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
